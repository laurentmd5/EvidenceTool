{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagnosis Result",
  "type": "object",
  "required": ["incident", "evidence", "policy", "decision", "recommendation"],
  "properties": {
    "incident": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "message", "observation", "is_stale"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
          "message": { "type": "string" },
          "observation": {
            "type": "object",
            "required": ["id", "source", "category", "collector", "method", "value", "message", "observed_at", "collected_at", "host"],
            "properties": {
              "id": { "type": "string" },
              "source": { "type": "string" },
              "category": { "type": "string" },
              "collector": { "type": "string" },
              "method": { "type": "string" },
              "value": { "type": ["object", "string", "number", "boolean", "null"] },
              "message": { "type": "string" },
              "observed_at": { "type": "string", "format": "date-time" },
              "collected_at": { "type": "string", "format": "date-time" },
              "host": { "type": ["string", "null"] },
              "execution_scope": { "type": ["string", "null"] },
              "target": { "type": ["string", "null"] },
              "capability": { "type": ["string", "null"] },
              "transport_status": { "type": ["string", "null"] }
            }
          },
          "is_stale": { "type": "boolean" }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["action", "risk"],
      "properties": {
        "action": { "type": "string" },
        "risk": { "type": "string" }
      }
    },
    "decision": {
      "type": "object",
      "required": ["status", "reason", "blocking_evidence"],
      "properties": {
        "status": { "enum": ["ALLOW", "BLOCK", "HUMAN_REVIEW"] },
        "reason": { "type": "string" },
        "blocking_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": { "type": "string" }
      }
    },
    "authority": {
      "type": "object",
      "required": ["caller_id", "caller_type"],
      "properties": {
        "caller_id": { "type": "string" },
        "caller_type": { "type": "string" },
        "session_id": { "type": ["string", "null"] },
        "policy_fingerprint": { "type": ["string", "null"] },
        "probes_budget": { "type": ["integer", "null"] },
        "probes_consumed": { "type": "integer" },
        "probes_remaining": { "type": ["integer", "null"] }
      }
    },
    "causality": {
      "type": "object",
      "required": ["status", "causal_chain", "propagated_symptoms", "precluded_hypotheses", "confidence"],
      "properties": {
        "status": { "enum": ["ROOT_CAUSE_IDENTIFIED", "ROOT_CAUSE_CONSTRAINED", "ROOT_CAUSE_UNKNOWN"] },
        "primary_root_cause": { "type": ["string", "null"] },
        "causal_chain": { "type": "array", "items": { "type": "string" } },
        "propagated_symptoms": { "type": "array", "items": { "type": "string" } },
        "precluded_hypotheses": { "type": "array", "items": { "type": "string" } },
        "candidate_causes": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "string" }
      }
    }
  }
}
