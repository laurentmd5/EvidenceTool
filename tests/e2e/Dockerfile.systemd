FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    systemd systemd-sysv \
    nginx \
    python3 python3-venv python3-pip \
    acl jq openssl sudo curl \
    && rm -rf /var/lib/apt/lists/*

# Create dedicated system user
RUN groupadd --system evidencetool && \
    useradd --system --gid evidencetool --shell /usr/sbin/nologin --no-create-home evidencetool

# Setup Nginx and TLS
RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/nginx.key -out /etc/nginx/ssl/nginx.crt \
    -subj "/C=US/ST=State/L=City/O=Org/OU=IT/CN=localhost"

# Grant evidencetool group read access to TLS files.
# The key is 640 (owner=root, group=evidencetool, others=none) — nginx
# runs as the evidencetool user so it can read it, and no other process can.
RUN chown root:evidencetool /etc/nginx/ssl/nginx.key && chmod 640 /etc/nginx/ssl/nginx.key && \
    chown root:evidencetool /etc/nginx/ssl/nginx.crt && chmod 644 /etc/nginx/ssl/nginx.crt

# Run nginx as the evidencetool user so it can read the TLS key.
# This mirrors the least-privilege setup documented in README.md.
RUN sed -i 's/^user www-data;/user evidencetool;/' /etc/nginx/nginx.conf

# Configure Nginx to use the certs
RUN echo "server {\n\
    listen 443 ssl;\n\
    server_name localhost;\n\
    ssl_certificate /etc/nginx/ssl/nginx.crt;\n\
    ssl_certificate_key /etc/nginx/ssl/nginx.key;\n\
    location / {\n\
        root /var/www/html;\n\
    }\n\
}" > /etc/nginx/sites-available/default

# Systemd requires this to run in docker
VOLUME [ "/sys/fs/cgroup" ]

# Setup EvidenceTool
COPY . /opt/EvidenceTool
WORKDIR /opt/EvidenceTool

# Install evidencetool + cryptography (needed by Scenario B to generate an expired cert)
RUN python3 -m venv .venv && \
    .venv/bin/pip install -e ".[test]"

# Remove the systemd default targets that cause issues in containers
RUN cd /lib/systemd/system/sysinit.target.wants/ && ls | grep -v systemd-tmpfiles-setup | xargs rm -f $1 && \
    rm -f /lib/systemd/system/multi-user.target.wants/* && \
    rm -f /etc/systemd/system/*.wants/* && \
    rm -f /lib/systemd/system/local-fs.target.wants/* && \
    rm -f /lib/systemd/system/sockets.target.wants/*udev* && \
    rm -f /lib/systemd/system/sockets.target.wants/*initctl* && \
    rm -f /lib/systemd/system/basic.target.wants/* && \
    rm -f /lib/systemd/system/anaconda.target.wants/*

# Make sure nginx is enabled
RUN systemctl enable nginx

CMD ["/lib/systemd/systemd"]
